{
	"name": "yeshua-academy-finance",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:server": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node-dev --respawn --transpile-only server/index.ts",
		"dev:full": "concurrently \"npm run dev:server\" \"npm run dev\"",
		"patch:rules:conditions": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node-dev --transpile-only server/scripts/add-categorization-rule-conditions.ts",
		"patch:prod:rules:conditions": "node scripts/patch-prod-conditions.mjs",
		"generate:ledger": "node scripts/generate-initial-ledger.js",
		"lint": "next lint",
		"test": "vitest run",
		"build": "next build",
		"prebuild": "prisma generate && npm run build:server",
		"build:server": "tsc -p tsconfig.server.json",
		"start": "node scripts/start-prod.mjs",
		"start:api": "node dist/server/index.js",
		"migrate": "prisma migrate deploy",
		"postinstall": "prisma generate",
		"validate:finance-readiness": "npm test && npm run build:server && npm run build && npx prisma validate && npx prisma generate",
		"validate:release-candidate": "npm test && npm run build:server && npm run build && DATABASE_URL=postgresql://finance_user:local_dev_placeholder@127.0.0.1:5432/yaf_validate npx prisma validate && npx prisma generate && node scripts/backup-restore-rehearsal.mjs --dry-run && git diff --check",
		"preflight:owner-go-no-go": "node scripts/owner-go-no-go-preflight.mjs",
		"preflight:owner-decision": "node scripts/owner-decision-preflight.mjs",
		"preflight:owner-action-plan": "node scripts/owner-approved-action-plan.mjs",
		"preflight:owner-decision-menu": "node scripts/owner-decision-menu.mjs",
		"preflight:owner-acceptance": "node scripts/final-owner-review-preflight.mjs --check && node scripts/owner-decision-menu.mjs",
		"preflight:push-readiness": "node scripts/push-readiness-preflight.mjs",
		"preflight:final-owner-review": "node scripts/final-owner-review-preflight.mjs --check",
		"preflight:approval-intake": "node scripts/owner-approval-intake-validator.mjs",
		"preflight:next-owner-decision": "npm test -- --test-name-pattern \"next owner decision recommendation\" && node scripts/owner-approval-intake-validator.mjs --decision postgres-version && node scripts/owner-decision-preflight.mjs --decision postgres-version",
		"preflight:post-push": "npm test -- --test-name-pattern \"post push verification\"",
		"preflight:decision-briefs": "npm test -- --test-name-pattern \"owner decision briefs\"",
		"audit:final-docs": "node scripts/final-docs-consistency-audit.mjs",
		"preflight:production-readiness": "node scripts/production-readiness-verify.mjs"
	},
	"dependencies": {
		"@clerk/nextjs": "^5.7.1",
		"@headlessui/react": "^1.7.18",
		"@prisma/client": "^6.15.0",
		"@radix-ui/react-accordion": "^1.2.0",
		"@radix-ui/react-avatar": "^1.1.1",
		"@radix-ui/react-dialog": "^1.1.1",
		"@radix-ui/react-navigation-menu": "^1.2.0",
		"@radix-ui/react-slider": "^1.2.1",
		"@radix-ui/react-slot": "^1.1.0",
		"@radix-ui/react-switch": "^1.1.1",
		"@radix-ui/react-tooltip": "^1.1.2",
		"@react-email/components": "^0.0.25",
		"@types/papaparse": "^5.3.16",
		"@types/xlsx": "^0.0.35",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"fast-csv": "^5.0.5",
		"lucide-react": "^0.408.0",
		"multer": "^2.0.2",
		"next": "^14.2.31",
		"next-themes": "^0.4.4",
		"nextjs-toploader": "^1.6.11",
		"papaparse": "^5.5.3",
		"pg": "^8.12.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-email": "^3.0.1",
		"react-hot-toast": "^2.4.1",
		"react-tooltip": "^5.26.3",
		"recharts": "^3.2.1",
		"resend": "^4.0.0",
		"tailwind-merge": "^2.4.0",
		"tailwindcss-animate": "^1.0.7",
		"xlsx": "^0.18.5",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@next/swc-darwin-arm64": "^14.2.31",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jest": "^29.5.12",
		"@types/multer": "^2.0.0",
		"@types/node": "^20.19.19",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"@typescript-eslint/eslint-plugin": "^7.16.0",
		"@typescript-eslint/parser": "^7.16.0",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.2.1",
		"eslint": "^8",
		"eslint-config-next": "^14.2.31",
		"husky": "^9.1.7",
		"postcss": "^8.4.49",
		"prisma": "^6.15.0",
		"tailwindcss": "^3.4.16",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5",
		"vitest": "^2.1.3"
	}
}
