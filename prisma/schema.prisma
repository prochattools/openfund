generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                     @id @default(uuid())
  email                       String                     @unique
  isActive                    Boolean                    @default(true)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @default(now()) @updatedAt
  memberships                 WorkspaceMembership[]
  accounts                    Account[]
  auditLogs                   AuditLog[]
  categorizationRules         CategorizationRule[]
  emailRecipients             EmailRecipient[]
  importBatches               ImportBatch[]
  ledgers                     Ledger[]
  transactions                Transaction[]
  merchantsCreated            Merchant[]                 @relation("MerchantCreatedBy")
  merchantsUpdated            Merchant[]                 @relation("MerchantUpdatedBy")
  merchantAliasesApproved     MerchantAlias[]
  merchantConflictsResolved   MerchantConflict[]
  merchantIdentityDecisions   MerchantIdentityDecision[]
  merchantAuditEvents         MerchantAuditEvent[]
  merchantBackfillRunsCreated MerchantBackfillRun[]
}

model FinanceWorkspace {
  id                        String                     @id @default(uuid())
  name                      String
  slug                      String                     @unique
  defaultCurrency           String                     @default("EUR")
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  memberships               WorkspaceMembership[]
  projects                  Project[]
  transactionTypes          TransactionType[]
  categories                Category[]
  transactionBookings       TransactionBooking[]
  categorizationSuggestions CategorizationSuggestion[]
  reviewDecisions           ReviewDecision[]
  sourceFiles               SourceFile[]
  bankStatements            BankStatement[]
  statementPeriods          StatementPeriod[]
  periodCloses              PeriodClose[]
  reportSnapshots           ReportSnapshot[]
  merchants                 Merchant[]
  merchantAliases           MerchantAlias[]
  merchantFingerprints      MerchantFingerprint[]
  merchantResolutions       MerchantResolution[]
  merchantConflicts         MerchantConflict[]
  merchantIdentityDecisions MerchantIdentityDecision[]
  merchantAuditEvents       MerchantAuditEvent[]
  merchantBackfillRuns      MerchantBackfillRun[]
  merchantBackfillResults   MerchantBackfillResult[]
}

model WorkspaceMembership {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole    @default(ADMIN)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  workspace   FinanceWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, isActive])
  @@index([workspaceId, role, isActive])
}

model Project {
  id                        String                     @id @default(uuid())
  workspaceId               String
  code                      String
  name                      String
  isActive                  Boolean                    @default(true)
  isHistorical              Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  workspace                 FinanceWorkspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  transactions              Transaction[]
  transactionBookings       TransactionBooking[]
  categorizationSuggestions CategorizationSuggestion[]
  beforeReviewDecisions     ReviewDecision[]           @relation("ReviewDecisionBeforeProject")
  afterReviewDecisions      ReviewDecision[]           @relation("ReviewDecisionAfterProject")
  reportSnapshotLines       ReportSnapshotLine[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
}

model TransactionType {
  id                        String                     @id @default(uuid())
  workspaceId               String
  literalName               String
  direction                 TransactionDirection?
  isActive                  Boolean                    @default(true)
  isHistorical              Boolean                    @default(false)
  sortOrder                 Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  workspace                 FinanceWorkspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  transactions              Transaction[]
  transactionBookings       TransactionBooking[]
  categorizationSuggestions CategorizationSuggestion[]
  beforeReviewDecisions     ReviewDecision[]           @relation("ReviewDecisionBeforeType")
  afterReviewDecisions      ReviewDecision[]           @relation("ReviewDecisionAfterType")
  reportSnapshotLines       ReportSnapshotLine[]

  @@unique([workspaceId, literalName])
  @@index([workspaceId, isActive, sortOrder])
}

model Category {
  id                        String                     @id @default(uuid())
  workspaceId               String                     @default("00000000-0000-4000-8000-000000000001")
  /// Exact literal category label retained under the legacy field name during additive migration.
  name                      String
  color                     String?
  isActive                  Boolean                    @default(true)
  isHistorical              Boolean                    @default(false)
  sortOrder                 Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  workspace                 FinanceWorkspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  categorizationRules       CategorizationRule[]
  transactions              Transaction[]
  transactionBookings       TransactionBooking[]
  categorizationSuggestions CategorizationSuggestion[]
  beforeReviewDecisions     ReviewDecision[]           @relation("ReviewDecisionBeforeCategory")
  afterReviewDecisions      ReviewDecision[]           @relation("ReviewDecisionAfterCategory")
  reportSnapshotLines       ReportSnapshotLine[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, sortOrder])
}

model Ledger {
  id           String               @id @default(uuid())
  userId       String
  month        Int
  year         Int
  createdAt    DateTime             @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  lockNote     String?
  rules        CategorizationRule[]
  user         User                 @relation(fields: [userId], references: [id])
  lock         LedgerLock?
  transactions Transaction[]
  periodCloses PeriodClose[]

  @@unique([userId, month, year])
}

model Account {
  id               String            @id @default(uuid())
  userId           String
  name             String
  identifier       String
  currency         String            @default("EUR")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  openingBalances  OpeningBalance[]
  transactions     Transaction[]
  bankStatements   BankStatement[]
  statementPeriods StatementPeriod[]

  @@unique([userId, identifier])
  @@index([userId])
}

model OpeningBalance {
  id            String    @id @default(uuid())
  accountId     String
  effectiveDate DateTime
  amountMinor   BigInt
  currency      String    @default("EUR")
  note          String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, effectiveDate])
  @@index([accountId, effectiveDate])
}

model LedgerLock {
  id        String   @id @default(uuid())
  ledgerId  String   @unique
  lockedAt  DateTime
  lockedBy  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
}

model ImportBatch {
  id                  String               @id @default(uuid())
  userId              String
  filename            String
  fileType            String?
  fileSizeBytes       Int?
  fileSha256          String?
  originalFile        Bytes?
  status              ImportBatchStatus    @default(pending)
  totalRows           Int                  @default(0)
  importedRows        Int                  @default(0)
  duplicateRows       Int                  @default(0)
  errorRows           Int                  @default(0)
  autoCategorizedRows Int                  @default(0)
  startedAt           DateTime             @default(now())
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  rules               CategorizationRule[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  bankStatements      BankStatement[]

  @@index([userId, startedAt])
}

model Transaction {
  id                        String                          @id @default(uuid())
  userId                    String
  ledgerId                  String?
  date                      DateTime
  description               String
  normalizedKey             String                          @default("")
  source                    String
  categoryId                String?
  projectId                 String?
  transactionTypeId         String?
  createdAt                 DateTime                        @default(now())
  accountId                 String?
  importBatchId             String?
  amountMinor               BigInt
  currency                  String                          @default("EUR")
  direction                 TransactionDirection            @default(credit)
  counterparty              String?
  reference                 String?
  hash                      String                          @unique
  sourceFile                String?
  rawRow                    Json?
  updatedAt                 DateTime                        @default(now())
  classificationSource      TransactionClassificationSource @default(none)
  classificationRuleId      String?
  importFingerprint         String?
  account                   Account?                        @relation(fields: [accountId], references: [id])
  category                  Category?                       @relation(fields: [categoryId], references: [id])
  project                   Project?                        @relation(fields: [projectId], references: [id])
  transactionType           TransactionType?                @relation(fields: [transactionTypeId], references: [id])
  classificationRule        CategorizationRule?             @relation(fields: [classificationRuleId], references: [id])
  importBatch               ImportBatch?                    @relation(fields: [importBatchId], references: [id])
  ledger                    Ledger?                         @relation(fields: [ledgerId], references: [id])
  user                      User                            @relation(fields: [userId], references: [id])
  transactionBooking        TransactionBooking?             @relation("TransactionCurrentBooking")
  historicalSourceBookings  TransactionBooking[]            @relation("HistoricalSourceTransaction")
  categorizationSuggestions CategorizationSuggestion[]
  reviewDecisions           ReviewDecision[]
  merchantAliases           MerchantAlias[]
  merchantFingerprints      MerchantFingerprint[]
  merchantResolutions       MerchantResolution[]
  merchantConflicts         MerchantConflict[]
  merchantBackfillResults   MerchantBackfillResult[]

  @@unique([userId, importFingerprint])
  @@index([userId, date])
  @@index([userId, normalizedKey, amountMinor])
  @@index([userId, accountId, date])
  @@index([classificationRuleId])
  @@index([projectId])
  @@index([transactionTypeId])
}

model TransactionBooking {
  id                            String              @id @default(uuid())
  workspaceId                   String
  transactionId                 String              @unique
  projectId                     String
  transactionTypeId             String
  categoryId                    String
  source                        BookingSource
  ruleId                        String?
  historicalSourceTransactionId String?
  historicalMatchKey            String?
  evidence                      Json
  evidenceHash                  String
  confirmedBy                   String?
  confirmedAt                   DateTime            @default(now())
  literalProjectLabel           String
  literalTypeLabel              String
  literalCategoryLabel          String
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @default(now()) @updatedAt
  workspace                     FinanceWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  transaction                   Transaction         @relation("TransactionCurrentBooking", fields: [transactionId], references: [id], onDelete: Restrict)
  project                       Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transactionType               TransactionType     @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  category                      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rule                          CategorizationRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  historicalSourceTransaction   Transaction?        @relation("HistoricalSourceTransaction", fields: [historicalSourceTransactionId], references: [id], onDelete: Restrict)
  beforeReviewDecisions         ReviewDecision[]    @relation("ReviewDecisionBeforeBooking")
  afterReviewDecisions          ReviewDecision[]    @relation("ReviewDecisionAfterBooking")

  @@index([workspaceId, source, confirmedAt])
  @@index([projectId])
  @@index([transactionTypeId])
  @@index([categoryId])
  @@index([ruleId])
  @@index([historicalSourceTransactionId])
  @@index([transactionId, evidenceHash])
}

model CategorizationSuggestion {
  id                String               @id @default(uuid())
  workspaceId       String
  transactionId     String
  projectId         String?
  transactionTypeId String?
  categoryId        String?
  confidence        SuggestionConfidence
  matcher           SuggestionMatcher
  rank              Int
  scoreBasisPoints  Int?
  evidence          Json
  evidenceHash      String
  /// Explicit producer ownership. Null is legacy/unowned and must never be claimed by a later producer.
  producerKey       String?
  producerVersion   String?
  planHash          String?
  status            SuggestionStatus     @default(PENDING)
  createdAt         DateTime             @default(now())
  resolvedAt        DateTime?
  workspace         FinanceWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  transaction       Transaction          @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  project           Project?             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transactionType   TransactionType?     @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  category          Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewDecisions   ReviewDecision[]

  @@index([workspaceId, transactionId, status, rank])
  @@index([workspaceId, status, createdAt])
  @@index([transactionId, status])
  @@index([categoryId])
  @@index([projectId])
  @@index([transactionTypeId])
  @@index([transactionId, matcher, evidenceHash])
  @@index([workspaceId, transactionId, producerKey, producerVersion, status], map: "CategorizationSuggestion_owner_lookup_idx")
  @@unique([workspaceId, transactionId, producerKey, producerVersion, evidenceHash], map: "CategorizationSuggestion_owner_evidence_key")
}

model ReviewDecision {
  id               String                    @id @default(uuid())
  workspaceId      String
  transactionId    String
  suggestionId     String?
  action           ReviewDecisionAction
  beforeBookingId  String?
  beforeProjectId  String?
  beforeTypeId     String?
  beforeCategoryId String?
  afterBookingId   String?
  afterProjectId   String?
  afterTypeId      String?
  afterCategoryId  String?
  actorId          String
  actorEmail       String?
  reason           String?
  evidence         Json
  evidenceHash     String
  decidedAt        DateTime                  @default(now())
  workspace        FinanceWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  transaction      Transaction               @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  suggestion       CategorizationSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: Restrict)
  beforeBooking    TransactionBooking?       @relation("ReviewDecisionBeforeBooking", fields: [beforeBookingId], references: [id], onDelete: Restrict)
  afterBooking     TransactionBooking?       @relation("ReviewDecisionAfterBooking", fields: [afterBookingId], references: [id], onDelete: Restrict)
  beforeProject    Project?                  @relation("ReviewDecisionBeforeProject", fields: [beforeProjectId], references: [id], onDelete: Restrict)
  afterProject     Project?                  @relation("ReviewDecisionAfterProject", fields: [afterProjectId], references: [id], onDelete: Restrict)
  beforeType       TransactionType?          @relation("ReviewDecisionBeforeType", fields: [beforeTypeId], references: [id], onDelete: Restrict)
  afterType        TransactionType?          @relation("ReviewDecisionAfterType", fields: [afterTypeId], references: [id], onDelete: Restrict)
  beforeCategory   Category?                 @relation("ReviewDecisionBeforeCategory", fields: [beforeCategoryId], references: [id], onDelete: Restrict)
  afterCategory    Category?                 @relation("ReviewDecisionAfterCategory", fields: [afterCategoryId], references: [id], onDelete: Restrict)

  @@index([workspaceId, transactionId, decidedAt])
  @@index([workspaceId, actorId, decidedAt])
  @@index([workspaceId, action, decidedAt])
  @@index([suggestionId])
  @@index([beforeBookingId])
  @@index([afterBookingId])
}

model SourceFile {
  id                   String           @id @default(uuid())
  workspaceId          String
  filename             String
  mediaType            String
  sizeBytes            Int
  sha256               String
  content              Bytes
  uploadedBy           String?
  createdAt            DateTime         @default(now())
  workspace            FinanceWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceStatements     BankStatement[]  @relation("BankStatementSourceFile")
  supportingStatements BankStatement[]  @relation("BankStatementSupportingPdf")

  @@unique([workspaceId, sha256])
  @@index([workspaceId, createdAt])
}

model BankStatement {
  id                    String                  @id @default(uuid())
  workspaceId           String
  accountId             String
  sourceFileId          String                  @unique
  supportingPdfFileId   String?
  importBatchId         String?
  periodStart           DateTime
  periodEnd             DateTime
  coverageStatus        StatementCoverageStatus
  currency              String                  @default("EUR")
  openingBalanceMinor   BigInt
  incomeMinor           BigInt
  expenseMinor          BigInt
  netMinor              BigInt
  closingBalanceMinor   BigInt
  transactionCount      Int
  bankAccountIdentifier String
  acceptedBy            String?
  acceptedAt            DateTime?
  createdAt             DateTime                @default(now())
  workspace             FinanceWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account               Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sourceFile            SourceFile              @relation("BankStatementSourceFile", fields: [sourceFileId], references: [id], onDelete: Restrict)
  supportingPdfFile     SourceFile?             @relation("BankStatementSupportingPdf", fields: [supportingPdfFileId], references: [id], onDelete: Restrict)
  importBatch           ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  periods               StatementPeriod[]
  periodCloses          PeriodClose[]

  @@unique([workspaceId, accountId, periodStart, periodEnd])
  @@index([workspaceId, accountId, periodStart, periodEnd])
  @@index([importBatchId])
  @@index([supportingPdfFileId])
}

model StatementPeriod {
  id                  String                  @id @default(uuid())
  workspaceId         String
  statementId         String
  accountId           String
  periodStart         DateTime
  periodEnd           DateTime
  coverageStatus      StatementCoverageStatus
  openingBalanceMinor BigInt
  incomeMinor         BigInt
  expenseMinor        BigInt
  netMinor            BigInt
  closingBalanceMinor BigInt
  transactionCount    Int
  createdAt           DateTime                @default(now())
  workspace           FinanceWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  statement           BankStatement           @relation(fields: [statementId], references: [id], onDelete: Restrict)
  account             Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodCloses        PeriodClose[]

  @@unique([statementId, accountId, periodStart, periodEnd])
  @@index([workspaceId, accountId, periodStart, periodEnd])
}

model PeriodClose {
  id                     String                      @id @default(uuid())
  workspaceId            String
  ledgerId               String
  statementId            String
  statementPeriodId      String
  version                Int
  status                 PeriodCloseStatus           @default(CLOSED)
  periodStart            DateTime
  periodEnd              DateTime
  openingBalanceMinor    BigInt
  incomeMinor            BigInt
  expenseMinor           BigInt
  netMinor               BigInt
  closingBalanceMinor    BigInt
  transactionCount       Int
  classificationHash     String
  sourceDataHash         String
  closedBy               String
  closedAt               DateTime                    @default(now())
  reopenedBy             String?
  reopenedAt             DateTime?
  reopenReason           String?
  reconciliationEvidence Json
  workspace              FinanceWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ledger                 Ledger                      @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  statement              BankStatement               @relation(fields: [statementId], references: [id], onDelete: Restrict)
  statementPeriod        StatementPeriod             @relation(fields: [statementPeriodId], references: [id], onDelete: Restrict)
  reportSnapshotLinks    ReportSnapshotPeriodClose[]

  @@unique([ledgerId, version])
  @@index([workspaceId, periodStart, periodEnd, status])
  @@index([statementPeriodId])
}

model ReportSnapshot {
  id                  String                      @id @default(uuid())
  workspaceId         String
  kind                ReportKind
  year                Int
  month               Int?
  version             Int
  openingBalanceMinor BigInt
  incomeMinor         BigInt
  expenseMinor        BigInt
  netMinor            BigInt
  closingBalanceMinor BigInt
  transactionCount    Int
  snapshotHash        String
  generatedBy         String
  generatedAt         DateTime                    @default(now())
  workspace           FinanceWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  periodCloseLinks    ReportSnapshotPeriodClose[]
  lines               ReportSnapshotLine[]
  artifacts           ReportArtifact[]
  approvals           ReportApproval[]
  dispatches          ReportDispatch[]

  @@unique([workspaceId, kind, year, month, version])
  @@index([workspaceId, kind, year, month])
  @@index([snapshotHash])
}

model ReportSnapshotPeriodClose {
  reportSnapshotId String
  periodCloseId    String
  sortOrder        Int
  reportSnapshot   ReportSnapshot @relation(fields: [reportSnapshotId], references: [id], onDelete: Cascade)
  periodClose      PeriodClose    @relation(fields: [periodCloseId], references: [id], onDelete: Restrict)

  @@id([reportSnapshotId, periodCloseId])
  @@index([periodCloseId])
}

model ReportSnapshotLine {
  id                   String                @id @default(uuid())
  reportSnapshotId     String
  lineKind             ReportLineKind
  projectId            String?
  transactionTypeId    String?
  categoryId           String?
  literalProjectLabel  String?
  literalTypeLabel     String?
  literalCategoryLabel String?
  direction            TransactionDirection?
  reportingClass       String?
  amountMinor          BigInt
  transactionCount     Int
  sortOrder            Int
  reportSnapshot       ReportSnapshot        @relation(fields: [reportSnapshotId], references: [id], onDelete: Cascade)
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transactionType      TransactionType?      @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([reportSnapshotId, lineKind, sortOrder])
  @@index([projectId])
  @@index([transactionTypeId])
  @@index([categoryId])
}

model ReportArtifact {
  id               String               @id @default(uuid())
  reportSnapshotId String
  format           ReportArtifactFormat
  filename         String
  mediaType        String
  sizeBytes        Int
  sha256           String
  content          Bytes
  generatedAt      DateTime             @default(now())
  reportSnapshot   ReportSnapshot       @relation(fields: [reportSnapshotId], references: [id], onDelete: Cascade)

  @@unique([reportSnapshotId, format])
  @@index([sha256])
}

model ReportApproval {
  id               String           @id @default(uuid())
  reportSnapshotId String
  approvedBy       String
  approvedAt       DateTime         @default(now())
  snapshotHash     String
  revokedBy        String?
  revokedAt        DateTime?
  revokeReason     String?
  reportSnapshot   ReportSnapshot   @relation(fields: [reportSnapshotId], references: [id], onDelete: Restrict)
  dispatches       ReportDispatch[]

  @@unique([reportSnapshotId, snapshotHash])
  @@index([reportSnapshotId, approvedAt])
}

model ReportDispatch {
  id                String                    @id @default(uuid())
  reportSnapshotId  String
  reportApprovalId  String
  deliveryKey       String                    @unique
  status            DispatchStatus            @default(PENDING)
  fromAddress       String
  subject           String
  recipientHash     String
  contentHash       String
  providerMessageId String?
  sentBy            String
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime                  @default(now())
  reportSnapshot    ReportSnapshot            @relation(fields: [reportSnapshotId], references: [id], onDelete: Restrict)
  reportApproval    ReportApproval            @relation(fields: [reportApprovalId], references: [id], onDelete: Restrict)
  recipients        ReportDispatchRecipient[]

  @@index([reportSnapshotId, createdAt])
  @@index([reportApprovalId])
  @@index([status, createdAt])
}

model ReportDispatchRecipient {
  id               String         @id @default(uuid())
  reportDispatchId String
  email            String
  name             String?
  reportDispatch   ReportDispatch @relation(fields: [reportDispatchId], references: [id], onDelete: Cascade)

  @@index([reportDispatchId])
}

model EmailRecipient {
  id        String   @id @default(uuid())
  userId    String
  email     String
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, isActive])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model CategorizationRule {
  id                  String               @id @default(uuid())
  userId              String
  importBatchId       String?
  ledgerId            String?
  categoryId          String
  label               String
  pattern             String?
  matchType           RuleMatchType?       @default(regex)
  matchField          RuleMatchField?      @default(description)
  conditions          Json?                @default("[]")
  priority            Int                  @default(100)
  isActive            Boolean              @default(true)
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastMatchedAt       DateTime?
  category            Category             @relation(fields: [categoryId], references: [id])
  importBatch         ImportBatch?         @relation(fields: [importBatchId], references: [id])
  ledger              Ledger?              @relation(fields: [ledgerId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  transactionBookings TransactionBooking[]

  @@index([userId, isActive, priority])
  @@index([ledgerId])
}

enum WorkspaceRole {
  ADMIN
  VIEWER
}

enum TransactionDirection {
  credit
  debit
}

enum ImportBatchStatus {
  pending
  completed
  failed
}

enum RuleMatchType {
  regex
  contains
  startsWith
  endsWith
}

