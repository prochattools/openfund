# Database
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=placeholder

# API
API_PORT=4000
INTERNAL_API_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
DEFAULT_USER_ID=demo-user
DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# Import and categorization
NEXT_PUBLIC_IMPORT_PIPELINE_MODE=server
AMOUNT_MATCH_THRESHOLD=0.01
RECONCILIATION_LOCKS_ENABLED=true

# Email summaries
RESEND_API_KEY=

# Auth provider. Production must use Clerk; disabled mode is local-only.
AUTH_PROVIDER=disabled
NEXT_PUBLIC_AUTH_PROVIDER=disabled
NEXT_PUBLIC_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_SIGN_UP_URL=/sign-in

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
